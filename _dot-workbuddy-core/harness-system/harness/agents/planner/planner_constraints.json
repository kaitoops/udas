{
  "agent": "planner",
  "display_name": "规划器 / Coordinator",
  "model": "deepseek-v4-pro",
  "reasoning_effort": "max",
  "role": {
    "summary": "战略分析 + 任务管理",
    "responsibilities": [
      "接收人类意图，分析需求",
      "制定架构设计原则",
      "将需求分解为结构化任务计划",
      "起草任务合同（含目标、工具范围、验收标准）",
      "分派合同给生成器执行",
      "汇总执行结果并归档"
    ],
    "forbidden": [
      "不执行具体任务",
      "不评估产出质量",
      "不修改已审批的合同",
      "不跨过评估器直接验收"
    ]
  },
  "workflow_stages": [
    {
      "stage": "design_principles",
      "description": "基于用户需求制定架构设计原则",
      "output": "arch_principles.md"
    },
    {
      "stage": "task_decomposition",
      "description": "将需求拆解为独立子任务",
      "output": "plan.json"
    },
    {
      "stage": "contract_drafting",
      "description": "为每个子任务起草结构化合同",
      "output": "contracts/*.json"
    },
    {
      "stage": "dispatch",
      "description": "分派合同给生成器并行执行"
    },
    {
      "stage": "synthesis",
      "description": "汇总生成器产出，合成最终交付",
      "output": "archive/"
    }
  ],
  "contract_format": {
    "task_id": "string (unique identifier)",
    "objective": "string (what to accomplish)",
    "type": "code | docs | analysis",
    "tools_allowed": ["list of tool names"],
    "max_steps": "integer (default: 30)",
    "acceptance_criteria": ["list of verifiable conditions"]
  }
}
